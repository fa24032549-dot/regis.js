<!DOCTYPE html>
<html lang="th">
<head>
  <title>ระบบข้อมูลนักศึกษา | มหาวิทยาลัยราชภัฏมหาสารคาม</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="/css/style.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <style>
    .student-navbar {
      padding: 0.85rem 0;
      background: linear-gradient(115deg, #102d4f, #174f72 58%, #167d83);
      box-shadow: 0 8px 24px rgba(15, 45, 79, 0.2);
      border-bottom: 3px solid #f4c95d;
    }

    .student-navbar .navbar-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      color: #fff;
      white-space: normal;
      transition: opacity 160ms ease;
    }

    .student-navbar .navbar-brand:hover {
      color: #fff;
      opacity: 0.9;
    }

    .student-navbar .brand-logo {
      width: 48px;
      height: 48px;
      flex: 0 0 48px;
      padding: 3px;
      border: 1px solid rgba(255, 255, 255, 0.55);
      border-radius: 50%;
      background: #fff;
      object-fit: contain;
    }

    .student-navbar .brand-title {
      display: block;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .student-navbar .brand-subtitle {
      display: block;
      margin-top: 0.15rem;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.75rem;
      font-weight: 400;
    }

    .student-navbar .navbar-toggler {
      border-color: rgba(255, 255, 255, 0.35);
    }

    .student-navbar .navbar-toggler:focus {
      box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.2);
    }

    .student-navbar .navbar-nav {
      gap: 0.35rem;
    }

    .student-navbar .nav-link {
      padding: 0.6rem 0.9rem;
      border-radius: 0.65rem;
      color: rgba(255, 255, 255, 0.82);
      font-size: 0.925rem;
      font-weight: 500;
      transition: background-color 160ms ease, color 160ms ease;
    }

    .student-navbar .nav-link:hover,
    .student-navbar .nav-link:focus-visible {
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
    }

    .student-navbar .nav-link-register {
      margin-left: 0.25rem;
      background: #f4c95d;
      color: #17324d;
      font-weight: 700;
    }

    .student-navbar .nav-link-register:hover,
    .student-navbar .nav-link-register:focus-visible {
      background: #ffda78;
      color: #102d4f;
    }

    .student-navbar .nav-link-logout:hover,
    .student-navbar .nav-link-logout:focus-visible {
      background: rgba(255, 255, 255, 0.12);
      color: #ffd2d2;
    }

    .student-navbar .leader-search {
      gap: 0.5rem;
      margin: 0.5rem 0 0 0.75rem;
    }

    .student-navbar .leader-search .form-control {
      min-width: 170px;
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 0.65rem;
      background: rgba(255, 255, 255, 0.96);
    }

    .student-navbar .leader-search .btn {
      border: 1px solid #f4c95d;
      border-radius: 0.65rem;
      background: #f4c95d;
      color: #17324d;
      font-weight: 700;
    }

    .student-navbar .leader-search .btn:hover,
    .student-navbar .leader-search .btn:focus-visible {
      border-color: #ffda78;
      background: #ffda78;
      color: #102d4f;
    }

    @media (max-width: 575.98px) {
      .student-navbar {
        padding: 0.65rem 0;
      }

      .student-navbar .brand-logo {
        width: 42px;
        height: 42px;
        flex-basis: 42px;
      }

      .student-navbar .brand-title {
        font-size: 0.9rem;
      }

      .student-navbar .brand-subtitle {
        font-size: 0.7rem;
      }

      .student-navbar .navbar-nav {
        padding-top: 0.75rem;
      }

      .student-navbar .leader-search {
        margin: 0.75rem 0 0;
      }

      .student-navbar .leader-search .form-control {
        min-width: 0;
      }

      .student-navbar .nav-link-register {
        margin: 0.25rem 0 0;
      }
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark student-navbar" aria-label="เมนูหลัก">
  <div class="container-fluid">
    <a class="navbar-brand" href="/showData">
      <img src="https://www.rmu.ac.th/images/logo_rmu.png" class="brand-logo" alt="ตรามหาวิทยาลัยราชภัฏมหาสารคาม">
      <span>
        <span class="brand-title">ระบบข้อมูลนักศึกษา</span>
        <span class="brand-subtitle">มหาวิทยาลัยราชภัฏมหาสารคาม</span>
      </span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#studentNavigation" aria-controls="studentNavigation" aria-expanded="false" aria-label="เปิดหรือปิดเมนู">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="studentNavigation">
      <ul class="navbar-nav ms-auto align-items-sm-center">
        <li class="nav-item">
          <a class="nav-link" href="/showData">ข้อมูลนักศึกษาทั้งหมด</a>
        </li>
        <li class="nav-item">
          <a class="nav-link nav-link-register" href="/register">เพิ่มข้อมูลนักศึกษา</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/auth_login">ล็อกอิน</a>
        </li>
        <li class="nav-item">
          <a class="nav-link nav-link-logout" href="/logout">ออกจากระบบ</a>
        </li>
      </ul>
      <form class="d-flex leader-search" action="/getdataByID" method="post" role="search">
        <label class="visually-hidden" for="header-stCode">ค้นหาด้วยรหัสนักศึกษา</label>
        <input class="form-control" type="search" id="header-stCode" name="stCode" placeholder="รหัสนักศึกษา" aria-label="รหัสนักศึกษา">
        <button class="btn" type="submit">ค้นหา</button>
      </form>
    </div>
  </div>
</nav>

</body>
</html>
