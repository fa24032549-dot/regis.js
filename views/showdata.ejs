<!DOCTYPE html>
<html lang="en">
<head>
  <title>ระบบพัฒนาฐานข้อมูลนักศึกษา</title>
  <meta charset="utf-8">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  
<div class="container mt-3">
<%-include('header') %>
  <h2>แสดงข้อมูลนักศึกษา</h2>
  <p>สาขาวิชาเทคโนโลยีสารสนเทศ</p>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>รหัสนักศึกษา</th>
        <th>ชื่อ สกุล</th>
        <th>สาขาวิชา</th>
        <th>ที่อยู่</th>
        <th>เบอร์โทร</th>
        <th>อีเมล์</th>
        <th>จัดการข้อมูล</th>
        
      </tr>
    </thead>
    <tbody>
      <% user.forEach(function(student){ %>
        <tr>
          <td><%= student.stCode %></td>
          <td><%= student.stName %></td>
          <td><%= student.stMajor %></td>
          <td><%= student.stAddress %></td>
          <td><%= student.stPhone %></td>
          <td><%= student.stEmail %></td>
          <td>
            <a href="/deleteData/<%= student.stCode %>" class="btn btn-danger btn-sm" onclick="return confirm('ต้องการลบข้อมูลนี้ใช่หรือไม่?')">ลบ</a>
            <a href="/frmEdit/<%= student.stCode %>" class="btn btn-warning btn-sm">แก้ไข</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%-include('footer') %>
</body>
</html>